# Copy this file to .env and fill in your values.

# MongoDB Atlas — same cluster as the Python scraper
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name (must match scraper DB_NAME)
DB_NAME=news_pulse

# Port the Express server listens on
PORT=5000

# Python executable name (python on Windows, python3 on Mac/Linux)
PYTHON_CMD=python

# Allowed CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173
