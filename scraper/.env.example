# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# MongoDB Atlas connection string (required)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name (optional — defaults to news_pulse)
DB_NAME=news_pulse

# DBSCAN tuning (optional — defaults shown)
DBSCAN_EPS=0.55
DBSCAN_MIN_SAMPLES=2
